//@version=5
indicator("Decoupled Asymmetric Strangle (DAS) [Model 4]", overlay=true)

// ==========================================
// INPUTS & PARAMETERS
// ==========================================
grp_model = "DAS Strategy Parameters"
vol_window      = input.int(15, "Volatility Rolling Window (Bars)", minval=5, maxval=30, group=grp_model)
std_thresh      = input.float(5.0, "Compression Std Thresh (Points)", minval=1.0, maxval=15.0, step=0.5, group=grp_model)
vel_thresh      = input.float(1.0, "Velocity Expansion Thresh (Points)", minval=0.5, maxval=5.0, step=0.25, group=grp_model)
win_target_pct  = input.float(50.0, "Winning Leg Target (%)", minval=20.0, maxval=100.0, step=5.0, group=grp_model)
lose_stop_pct   = input.float(35.0, "Losing Leg Stop Loss (%)", minval=15.0, maxval=50.0, step=5.0, group=grp_model)
max_hold_bars   = input.int(25, "Max Hold Time (Bars/Mins)", minval=10, maxval=60, group=grp_model)
budget_limit    = input.float(10000.0, "Max Capital Budget (INR)", group=grp_model)

grp_time = "Session Filters (IST)"
start_hour      = input.int(9, "Trade Start Hour", minval=9, maxval=15, group=grp_time)
start_min       = input.int(45, "Trade Start Minute", minval=0, maxval=59, group=grp_time)
end_hour        = input.int(14, "Trade End Hour", minval=9, maxval=15, group=grp_time)
end_min         = input.int(15, "Trade End Minute", minval=0, maxval=59, group=grp_time)
chop_start_h    = input.int(11, "Chop Start Hour", group=grp_time)
chop_start_m    = input.int(30, "Chop Start Minute", group=grp_time)
chop_end_h      = input.int(13, "Chop End Hour", group=grp_time)
chop_end_m      = input.int(0, "Chop End Minute", group=grp_time)

// ==========================================
// TIME & SESSION VALIDATION
// ==========================================
t_now_min = hour * 60 + minute
t_start = start_hour * 60 + start_min
t_end = end_hour * 60 + end_min
t_chop_s = chop_start_h * 60 + chop_start_m
t_chop_e = chop_end_h * 60 + chop_end_m

in_trade_window = (t_now_min >= t_start) and (t_now_min <= t_end)
in_chop_window  = (t_now_min >= t_chop_s) and (t_now_min <= t_chop_e)
is_valid_window = in_trade_window and not in_chop_window

// ==========================================
// VOLATILITY COMPRESSION & EXPANSION ENGINE
// ==========================================
// Rolling price range and standard deviation as proxy for option volatility coiling
atr_val = ta.atr(vol_window)
spot_std = ta.stdev(close, vol_window)
spot_vel = close - close[1]
combined_vel = math.abs(close - close[1]) + (atr_val - atr_val[1])

is_compressed = spot_std < (close * 0.0008) // Micro-range coiling
is_expanding  = combined_vel >= 1.0

das_trigger = is_valid_window and is_compressed[1] and (combined_vel >= vel_thresh) and (ta.change(time("D")) == 0)

// Dynamic ATM & OTM Strike Calculation
atm_strike = math.round(close / 50.0) * 50
otm_ce = atm_strike + 50
otm_pe = atm_strike - 50

// ==========================================
// PLOTTING & VISUAL SIGNALS
// ==========================================
plotshape(das_trigger, title="DAS Breakout Entry", style=shape.diamond, location=location.belowbar, color=color.new(color.yellow, 0), size=size.normal, text="DAS BUY\n(CE+PE)")

// Plotting chop background
bgcolor(in_chop_window ? color.new(color.gray, 92) : na, title="Midday Chop Filter")

// ==========================================
// DASHBOARD HUD TABLE
// ==========================================
var table hud = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 15), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "Strategy", text_color=color.yellow, text_size=size.small)
    table.cell(hud, 1, 0, "DAS (Model 4)", text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 1, "Status", text_color=color.gray, text_size=size.small)
    string st_text = in_chop_window ? "CHOP FILTER (IDLE)" : (is_valid_window ? (is_compressed ? "COILING (ARMED)" : "ACTIVE SCAN") : "OUTSIDE HOURS")
    color st_col = in_chop_window ? color.orange : (is_compressed ? color.green : color.white)
    table.cell(hud, 1, 1, st_text, text_color=st_col, text_size=size.small)
    
    table.cell(hud, 0, 2, "Rec. CE Strike", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(otm_ce) + " CE (~50 pts)", text_color=color.green, text_size=size.small)
    
    table.cell(hud, 0, 3, "Rec. PE Strike", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(otm_pe) + " PE (~50 pts)", text_color=color.red, text_size=size.small)
    
    table.cell(hud, 0, 4, "Capital Budget", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 4, "<= INR 10,000", text_color=color.cyan, text_size=size.small)
    
    table.cell(hud, 0, 5, "Winning Target", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 5, "+50% Profit", text_color=color.green, text_size=size.small)
    
    table.cell(hud, 0, 6, "Losing Leg SL", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 6, "-35% Capped SL", text_color=color.red, text_size=size.small)
    
    table.cell(hud, 0, 7, "Max Hold Time", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 7, "25 Minutes", text_color=color.white, text_size=size.small)
