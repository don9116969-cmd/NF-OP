//@version=5
indicator("Strategy 3: 30-Minute Statistical Box Breakout [Champion]", overlay=true)

// ==========================================
// INPUTS & PARAMETERS
// ==========================================
max_box_pct      = input.float(0.32, "Max 30M Range (% of Spot)", minval=0.15, maxval=0.60, step=0.01)
buffer_pts       = input.float(6.0, "Breakout Buffer (Points)", minval=2.0, maxval=15.0, step=1.0)
strike_type      = input.string("ITM_50", "Strike Selection", options=["ITM_50", "ATM", "OTM_50"])
sl_pct           = input.float(15.0, "Stop-Loss (%)", minval=5.0, maxval=40.0, step=5.0)
target_pct       = input.float(80.0, "Profit Target (%)", minval=30.0, maxval=150.0, step=10.0)
trail_trigger    = input.float(25.0, "Breakeven Trailing Trigger (%)", minval=10.0, maxval=50.0, step=5.0)

// ==========================================
// 30-MINUTE INITIAL BALANCE (09:15 - 09:45 AM)
// ==========================================
is_new_day = ta.change(time("D")) != 0

var float ib_high = na
var float ib_low = na
var float ib_pct = na
var bool ib_qualified = false
var bool signal_today = false
var int current_signal = 0 // +1 CE, -1 PE
var float entry_spot = na
var int recommended_strike = na
var string opt_type = ""

if is_new_day
    ib_high := na
    ib_low := na
    ib_pct := na
    ib_qualified := false
    signal_today := false
    current_signal := 0
    entry_spot := na
    recommended_strike := na
    opt_type := ""

is_ib_window = (hour == 9 and minute >= 15 and minute < 45)
is_trade_window = ((hour == 9 and minute >= 45) or (hour >= 10 and hour < 13) or (hour == 13 and minute <= 30))

if is_ib_window
    if na(ib_high) or high > ib_high
        ib_high := high
    if na(ib_low) or low < ib_low
        ib_low := low

// At 09:45 candle close: evaluate Initial Balance compression
if (hour == 9 and minute == 45 and not ib_qualified and na(ib_pct))
    if not na(ib_high) and not na(ib_low)
        ib_range = ib_high - ib_low
        ib_pct := (ib_range / close) * 100.0
        if ib_pct <= max_box_pct
            ib_qualified := true

// Breakout Detection (09:45 to 13:30)
if ib_qualified and not signal_today and is_trade_window
    // Upside Breakout -> CALL BUY
    if high >= (ib_high + buffer_pts)
        signal_today := true
        current_signal := 1
        entry_spot := close
        opt_type := "CE"
        atm = math.round(close / 50.0) * 50
        recommended_strike := strike_type == "ITM_50" ? int(atm - 50) : (strike_type == "ATM" ? int(atm) : int(atm + 50))

    // Downside Breakout -> PUT BUY
    else if low <= (ib_low - buffer_pts)
        signal_today := true
        current_signal := -1
        entry_spot := close
        opt_type := "PE"
        atm = math.round(close / 50.0) * 50
        recommended_strike := strike_type == "ITM_50" ? int(atm + 50) : (strike_type == "ATM" ? int(atm) : int(atm - 50))

// ==========================================
// PLOTS & SIGNALS
// ==========================================
plot(ib_qualified ? (ib_high + buffer_pts) : na, "Upper Breakout Trigger (+6 pts)", color=color.green, style=plot.style_linebr, linewidth=2)
plot(ib_qualified ? (ib_low - buffer_pts) : na, "Lower Breakout Trigger (-6 pts)", color=color.red, style=plot.style_linebr, linewidth=2)
plot(ib_qualified ? ib_high : na, "30M IB High", color=color.gray, style=plot.style_circles)
plot(ib_qualified ? ib_low : na, "30M IB Low", color=color.gray, style=plot.style_circles)

plotshape(current_signal == 1 and ta.change(current_signal), title="Directional CE Buy",
          style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.normal, text="BUY " + strike_type + " CE")
plotshape(current_signal == -1 and ta.change(current_signal), title="Directional PE Buy",
          style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal, text="BUY " + strike_type + " PE")

// ==========================================
// DASHBOARD TABLE
// ==========================================
var table info = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "Strategy", text_color=color.white, bgcolor=color.purple)
    table.cell(info, 1, 0, "30M Statistical Box Breakout", text_color=color.yellow, bgcolor=color.purple)

    table.cell(info, 0, 1, "30M Box Range", text_color=color.white)
    string rng_str = not na(ib_high) and not na(ib_low) ? str.tostring(ib_high - ib_low, "#.##") + " pts (" + str.tostring(ib_pct, "#.##") + "%)" : "Forming..."
    table.cell(info, 1, 1, rng_str, text_color=color.white)

    table.cell(info, 0, 2, "Box Status", text_color=color.white)
    string st_str = ib_qualified ? "QUALIFIED (<=" + str.tostring(max_box_pct, "#.##") + "%)" : (not na(ib_pct) ? "FILTERED (Too Wide)" : "Measuring IB...")
    table.cell(info, 1, 2, st_str, text_color=ib_qualified ? color.green : (not na(ib_pct) ? color.orange : color.yellow))

    table.cell(info, 0, 3, "Recommended Trade", text_color=color.white)
    string tr_str = signal_today ? "BUY " + str.tostring(recommended_strike) + " " + opt_type + " (" + strike_type + ")" : (ib_qualified ? "ARMED: WAITING FOR BREAKOUT" : "STANDBY")
    table.cell(info, 1, 3, tr_str, text_color=signal_today ? (opt_type == "CE" ? color.lime : color.red) : color.white)

    table.cell(info, 0, 4, "Risk Controls", text_color=color.white)
    table.cell(info, 1, 4, "SL: -" + str.tostring(sl_pct, "#") + "% | Target: +" + str.tostring(target_pct, "#") + "%", text_color=color.aqua)

    table.cell(info, 0, 5, "Trailing Protection", text_color=color.white)
    table.cell(info, 1, 5, "Trail to Breakeven at +" + str.tostring(trail_trigger, "#") + "%", text_color=color.lime)
